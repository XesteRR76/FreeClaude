# ========================================================
# FreeClaude (Claude Code -> Google Gemini Proxy) Config
# ========================================================

# Comma-separated Google Gemini API keys for rotation
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_API_KEY=your_gemini_api_key_1

# Cascading fallback models list
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Proxy server host and port
PROXY_HOST=127.0.0.1
PROXY_PORT=8080

# Key cooldown in seconds after HTTP 429
COOLDOWN_SECONDS=60

# Model cooldown in seconds after HTTP 503
MODEL_OVERLOAD_COOLDOWN_SECONDS=30

# Request timeout in seconds
REQUEST_TIMEOUT=120
